{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": ".tsbuild/node",
    "rootDir": ".",
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"]
