{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": ".tsbuild/app",
    "rootDir": "src",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": []
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "src/testing/**"],
  "references": [{ "path": "../../packages/core" }, { "path": "../../packages/ui" }]
}
